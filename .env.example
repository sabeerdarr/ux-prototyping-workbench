# Copy to .env.local and fill in. These are read on the server only.

# Anthropic API key. Without it the app runs in demo mode (prebuilt example, no AI).
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# ANTHROPIC_TIMEOUT_MS=300000
# ANTHROPIC_FALLBACKS=on           # "off" disables server-side refusal fallbacks
# DESIGN_PROVIDER=demo             # force demo mode even with a key
# WORKBENCH_DATA_DIR=./data/projects
